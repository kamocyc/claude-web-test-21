    "test:watch": "vitest",
    "sim:headless": "tsx src/sim/harness.ts"
  },
  "dependencies": {
    "three": "^0.171.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/three": "^0.171.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
