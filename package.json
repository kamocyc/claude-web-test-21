{
  "name": "japan-city-sim",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "エージェントベースの日本都市シミュレーションゲーム",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
